# Build stage
FROM rust:1.96-slim-trixie as builder

WORKDIR /build

# Install dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY Cargo.toml Cargo.lock ./
COPY src ./src

# Copy sqlx offline query cache and migrations so compile-time checked
# queries (sqlx::query!/query_as!) can be verified without a live DB
# connection during the Docker build.
COPY .sqlx ./.sqlx
COPY migrations ./migrations

# Force sqlx to use the committed .sqlx cache instead of attempting to
# reach a live DATABASE_URL, which is not available in the build context.
ENV SQLX_OFFLINE=true

# Build the application
RUN cargo build --release

# Runtime stage
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/target/release/depin-orcha /app/

# Create necessary directories
RUN mkdir -p /data /config /logs

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["/app/depin-orcha"]
